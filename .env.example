# ==========================================
# Musafir / Raahi Environment Configuration
# ==========================================

# 1. Database Configuration (Managed PostgreSQL or Local PostgreSQL)
# Example managed providers: Supabase, Neon, Render, Railway, AWS RDS
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musafir_db

# 2. Authentication, Session Cookies & CORS
# Comma-separated list of allowed frontend origins (no wildcard '*' when credentials=true)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SESSION_COOKIE_NAME=raahi_session
SESSION_TTL_HOURS=168
# For cross-site production deployments (e.g., Vercel frontend + Render backend), set:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Optional cookie domain (leave empty for host-only cookies)
COOKIE_DOMAIN=

# Legacy / internal secret placeholder (do not use default in production)
ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# 3. Groq AI Insights & RAG Configuration
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# 4. Community Abuse and Moderation Rules
RATE_LIMIT_MINUTES=45
STALE_WINDOW_MINUTES=120
DAILY_POINTS_CAP=100
POINTS_PER_CHECKIN=20
POINTS_FOR_GEM_APPROVAL=50

# 5. Frontend API Endpoint
# Points the Vite / React frontend to the FastAPI server (must include /api suffix)
VITE_API_URL=http://localhost:8000/api
